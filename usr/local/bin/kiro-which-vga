#!/bin/bash
set -Euo pipefail
##################################################################################################################
# Author    : Erik Dubois
# Website   : https://kiroproject.be
##################################################################################################################
#
#   DO NOT JUST RUN THIS. EXAMINE AND JUDGE. RUN AT YOUR OWN RISK.
#
#   Purpose:
#   Identifies the active GPU driver and OpenGL renderer
#   (NVIDIA / AMD / Intel / virtio / etc.).
#
#   Why: many troubleshooting steps branch on GPU type; this is the
#   canonical detector so other scripts and humans agree on what's
#   running.
#
##################################################################################################################

# shellcheck source=/usr/local/lib/kiro-common.sh
if [[ -f /usr/local/lib/kiro-common.sh ]]; then
    source /usr/local/lib/kiro-common.sh
else
    echo "ERROR: kiro-common.sh not found" >&2
    exit 1
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
DRY_RUN=false

main() {
    for arg in "$@"; do
        case "$arg" in
            -h|--help)
                show_help "$(basename "$0")" \
                    "Identify the active GPU driver and OpenGL renderer" \
                    "[--help] [--version] [--dry-run]" \
                    ""
                exit 0
                ;;
            -v|--version)
                show_version "$(basename "$0")"
                exit 0
                ;;
            -d|--dry-run)
                DRY_RUN=true
                log_info "$(_t "Dry-run mode enabled — no changes will be made")"
                ;;
            *)
                echo "${RED}$(_t "Unknown option:") ${arg}${RESET}" >&2
                exit 1
                ;;
        esac
    done

    log_warn "$(_t "Some commands will give no output or error messages — one of them should give you info")"

    log_section "$(_t "Check 1 — lspci")"
    echo "$(_t "command 1:")"
    lspci -vnnn | perl -lne 'print if /^\d+\:.+(\[\S+\:\S+\])/' | grep VGA
    echo
    echo "$(_t "command 2:")"
    lspci -x | grep VGA

    log_section "$(_t "Check 2 — glxinfo")"
    if test -f /usr/bin/glxinfo; then
        log_info "$(_t "glxinfo is present")"
    else
        log_info "$(_t "Installing glxinfo (note: conflicts with mesa-demos)")"
        execute_or_dryrun "Install glxinfo" sudo pacman -S glxinfo --noconfirm
    fi
    if [[ "$DRY_RUN" == "true" ]] && ! command -v glxinfo &>/dev/null; then
        log_info "$(_t "[DRY-RUN] Would run: glxinfo | grep OpenGL vendor/renderer")"
    else
        glxinfo | grep -E "OpenGL vendor|OpenGL renderer*"
    fi

    log_section "$(_t "Check 3 — nvidia-smi")"
    if test -f /usr/bin/nvidia-smi; then
        nvidia-smi -L
    else
        log_info "$(_t "No nvidia driver present")"
    fi

    log_success "$(_tf '$SCRIPT_NAME done')"
}

main "$@"
