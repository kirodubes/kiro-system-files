#!/bin/bash
set -Euo pipefail
##################################################################################################################
# Author    : Erik Dubois
# Website   : https://kiroproject.be
##################################################################################################################
#
#   DO NOT JUST RUN THIS. EXAMINE AND JUDGE. RUN AT YOUR OWN RISK.
#
#   Purpose:
#   On a KiroTux system, make sure /etc/pacman.conf has [kirotux_repo], placed before
#   [nemesis_repo]. Does nothing on Kiro, and nothing when the repo is already there.
#
#   Why: tools that reset pacman.conf (kiro-fix-pacman-conf, ATT's reset buttons) copy
#   Kiro's default file, which has no [kirotux_repo]. Without it, KiroTux packages that
#   stay installed (kirotux-thunar, the SDDM theme) stop getting updates. KiroTux is
#   recognised by "kirotux" in /etc/os-release or ISO_CODENAME=kirotux in /etc/dev-rel.
#
##################################################################################################################

# shellcheck source=/usr/local/lib/kiro-common.sh
if [[ -f /usr/local/lib/kiro-common.sh ]]; then
    source /usr/local/lib/kiro-common.sh
else
    echo "ERROR: kiro-common.sh not found" >&2
    exit 1
fi

DRY_RUN=false

main() {
    local conf="/etc/pacman.conf"
    for arg in "$@"; do
        case "$arg" in
            -h|--help)
                show_help "$(basename "$0")" \
                    "On KiroTux, put [kirotux_repo] back into /etc/pacman.conf when it is missing" \
                    "[--help] [--version] [--dry-run]" \
                    ""
                exit 0
                ;;
            -v|--version)
                show_version "$(basename "$0")"
                exit 0
                ;;
            -d|--dry-run)
                DRY_RUN=true
                ;;
            *)
                echo "${RED}Unknown option: $arg${RESET}" >&2
                exit 1
                ;;
        esac
    done

    if ! is_kirotux; then
        log_info "Not a KiroTux system: nothing to do"
        return 0
    fi
    if grep -q '^\[kirotux_repo\]' "${conf}" 2>/dev/null; then
        log_info "[kirotux_repo] is already in ${conf}"
        return 0
    fi
    if [[ "${DRY_RUN}" == true ]]; then
        log_info "[DRY-RUN] Would add [kirotux_repo] before [nemesis_repo] in ${conf}"
        return 0
    fi
    ensure_kirotux_repo "${conf}"
}

main "$@"
