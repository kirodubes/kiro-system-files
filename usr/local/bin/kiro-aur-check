#!/bin/bash
set -Euo pipefail
##################################################################################################################
# Author    : Erik Dubois
# Website   : https://kiroproject.be
##################################################################################################################
#
#   DO NOT JUST RUN THIS. EXAMINE AND JUDGE. RUN AT YOUR OWN RISK.
#
#   Purpose:
#   Shows the lines of an AUR package worth a look before it is built. paru runs it from
#   PreBuildCommand ([bin] in /etc/paru.conf, set by kiro-paru-aur-check) in the folder that
#   holds the PKGBUILD, with PKGBASE set; yay (13+) runs it from its AURPreInstall hook (set by
#   kiro-yay-aur-check). It runs cachyos-pi-scan (CachyOS's rules, read-only: nothing from the
#   package is executed), adds the package's AUR history (orphaned, new,
#   maintainer changed, few votes) and, on a dangerous finding, asks before the build goes on.
#   Exit 1 stops paru or yay; warnings and notes never stop a build. Also usable by hand:
#   kiro-aur-check [folder-with-PKGBUILD].
#
#   Why: AUR malware runs inside makepkg, as the user, before pacman is ever called — the
#   only moment to look is before the build.
#
##################################################################################################################

# shellcheck source=/usr/local/lib/kiro-common.sh
if [[ -f /usr/local/lib/kiro-common.sh ]]; then
    source /usr/local/lib/kiro-common.sh
else
    echo "ERROR: kiro-common.sh not found" >&2
    exit 1
fi

# shellcheck disable=SC2034  # template variable, unused here
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SCANNER="${KIRO_PI_SCAN:-/usr/bin/cachyos-pi-scan}"   # override for tests
AUR_RPC="https://aur.archlinux.org/rpc/v5/info"

# Same thresholds as CachyOS Package Installer's scanMetadata (src/pkgscan.cpp)
aur_history() {
    local pkgbase="$1" json
    json="$(curl -fsS --max-time 5 --get --data-urlencode "arg[]=${pkgbase}" "${AUR_RPC}" 2>/dev/null)" || {
        echo "AUR history: skipped (no answer from aur.archlinux.org)"
        return 0
    }
    printf '%s' "${json}" | python3 -I -c '
import json, sys, time
try:
    results = json.load(sys.stdin).get("results") or []
except ValueError:
    results = []
if not results:
    print("AUR history: not on the AUR (a local PKGBUILD?)")
    sys.exit(0)
p = results[0]
now = time.time()
age_days = (now - (p.get("FirstSubmitted") or now)) / 86400
edit_hours = (now - (p.get("LastModified") or 0)) / 3600
maint, sub = p.get("Maintainer"), p.get("Submitter")
votes, pop = p.get("NumVotes") or 0, p.get("Popularity") or 0.0
out = []
if not maint:
    out.append(("WARNING", "Nobody maintains this package",
                "Orphaned packages can be adopted by anyone, and nobody is watching for problems."))
elif sub and sub != maint:
    out.append(("INFO", "The maintainer has changed",
                f"Submitted by {sub}, now maintained by {maint}. Taking over an abandoned package is a known way to slip in malware."))
if age_days < 30:
    out.append(("WARNING", "This package is very new",
                f"It was first submitted {int(age_days)} day(s) ago, so few people have looked at it."))
if edit_hours < 72 and age_days >= 30:
    out.append(("INFO", "This package changed very recently",
                f"The last change is {int(edit_hours)} hour(s) old. Malicious updates are usually found and removed within days."))
if votes < 3 and pop < 0.05:
    out.append(("INFO", "Hardly anybody uses this package",
                f"It has {votes} vote(s). Problems in rarely used packages stay unnoticed for longer."))
for level, title, detail in out:
    print(f"[{level}] {title}\n    {detail}")
who = maint or "none"
base = p.get("PackageBase") or ""
print(f"AUR: {votes} votes, maintainer {who}, https://aur.archlinux.org/pkgbase/{base}")
' || echo "AUR history: skipped (could not read the answer)"
}

MAX_DIFF_LINES=200
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

# git as CachyOS's Package Installer runs it on an AUR clone: no hooks, no external diff or textconv, and no
# attributes from the package, so a .gitattributes cannot hide its changes (for example by marking them binary).
safe_git() {
    GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0 \
        git -c core.hooksPath=/dev/null -c core.quotePath=false --attr-source="${EMPTY_TREE}" "$@"
}

# [epoch:]pkgver-pkgrel of the pkgbase section of a .SRCINFO read on stdin
srcinfo_version() {
    awk -F ' = ' '
        /^pkgname = / { exit }
        /^[[:space:]]*pkgver = / { ver = $2 }
        /^[[:space:]]*pkgrel = / { rel = $2 }
        /^[[:space:]]*epoch = /  { epoch = $2 }
        END { if (ver != "") printf "%s%s-%s", (epoch != "" ? epoch ":" : ""), ver, rel }
    '
}

# On an update: what changed in the package's files (not .SRCINFO) since the installed version, from the AUR git
# clone paru and yay build in. Same method as CachyOS (aurclient.cpp findCommit/diffSince).
update_diff() {
    local dir="$1" installed="" name commit version found="" diff total more where
    safe_git -C "${dir}" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
    [[ -f "${dir}/.SRCINFO" ]] || return 0
    while read -r name; do
        installed="$(pacman -Q -- "${name}" 2>/dev/null | awk '{ print $2 }')" || installed=""
        [[ -n "${installed}" ]] && break
    done < <(sed -n 's/^pkgname = //p' "${dir}/.SRCINFO")
    [[ -n "${installed}" ]] || return 0

    # The oldest commit with that version: a maintainer can name an old version again later, and starting
    # there would leave out what was added in between.
    while read -r commit; do
        version="$(safe_git -C "${dir}" show "${commit}:.SRCINFO" 2>/dev/null | srcinfo_version)" || version=""
        [[ -n "${version}" && "$(vercmp "${version}" "${installed}")" == "0" ]] && found="${commit}"
    done < <(safe_git -C "${dir}" rev-list --max-count=200 HEAD -- .SRCINFO 2>/dev/null)
    if [[ -z "${found}" ]]; then
        log_info "$(_tf 'The installed version $installed is not in the AUR history of this package, so there are no changes to show (usual for -git packages).')"
        return 0
    fi

    local color="--no-color"
    [[ -t 1 ]] && color="--color=always"
    diff="$(safe_git -C "${dir}" diff "${color}" --no-ext-diff --no-textconv --no-renames --unified=3 \
        "${found}" HEAD -- . ':(exclude).SRCINFO' 2>/dev/null)" || return 0
    if [[ -z "${diff}" ]]; then
        log_info "$(_tf 'The package files have not changed since the installed version $installed.')"
        return 0
    fi
    echo "${BOLD}$(_tf 'Changes since the installed version $installed:')${RESET}"
    total="$(printf '%s\n' "${diff}" | wc -l)"
    printf '%s\n' "${diff}" | head -n "${MAX_DIFF_LINES}" || true
    if (( total > MAX_DIFF_LINES )); then
        # shellcheck disable=SC2034  # read inside the _tf string
        more=$(( total - MAX_DIFF_LINES ))
        # shellcheck disable=SC2034
        where="git -C $(cd -- "${dir}" && pwd) diff ${found:0:12} HEAD"
        log_info "$(_tf '$more more lines. Read them all with: $where')"
    fi
}

# Orange needs a 256-colour terminal; elsewhere warnings fall back to yellow. Empty when not a terminal.
ORANGE="${YELLOW}"
if [[ -n "${YELLOW}" ]] && (( $(tput colors 2>/dev/null || echo 8) >= 256 )); then
    ORANGE="$(tput setaf 208)"
fi

# Colour the level tag a finding line starts with: [DANGER] red, [WARNING] orange, [INFO] blue.
colorize() {
    awk -v danger="${BOLD}${RED}" -v warning="${BOLD}${ORANGE}" -v info="${BLUE}" -v reset="${RESET}" '
        /^[[:space:]]*\[DANGER\]/  { sub(/\[DANGER\]/, danger "[DANGER]" reset) }
        /^[[:space:]]*\[WARNING\]/ { sub(/\[WARNING\]/, warning "[WARNING]" reset) }
        /^[[:space:]]*\[INFO\]/    { sub(/\[INFO\]/, info "[INFO]" reset) }
        { print }
    '
}

pkgbase_of() {
    local dir="$1" name=""
    [[ -f "${dir}/.SRCINFO" ]] && name="$(sed -n 's/^pkgbase = //p' "${dir}/.SRCINFO" | head -1)"
    [[ -z "${name}" ]] && name="$(basename "$(cd -- "${dir}" && pwd)")"
    printf '%s' "${name}"
}

ask_to_continue() {
    local pkgbase="$1" answer=""
    if ! { : < /dev/tty; } 2>/dev/null; then
        log_warn "$(_tf 'Dangerous lines found and nobody to ask: the build of $pkgbase is stopped.')"
        exit 1
    fi
    echo
    # Translators: keep [y/N] and the answer keys y/N as they are
    printf '%s ' "${YELLOW}$(_tf 'Continue building $pkgbase anyway? [y/N]')${RESET}" > /dev/tty
    read -r answer < /dev/tty || answer=""
    [[ "${answer}" == [yY] ]]
}

main() {
    local dir="." arg
    for arg in "$@"; do
        case "$arg" in
            -h|--help)
                show_help "$(basename "$0")" \
                    "Show the lines of an AUR package worth a look before paru or yay builds it" \
                    "[--help] [--version] [folder-with-PKGBUILD]" \
                    "paru runs this from PreBuildCommand, yay from its AURPreInstall hook; see kiro-paru-aur-check and kiro-yay-aur-check"
                exit 0
                ;;
            -v|--version)
                show_version "$(basename "$0")"
                exit 0
                ;;
            -*)
                echo "${RED}$(_t "Unknown option:") ${arg}${RESET}" >&2
                exit 1
                ;;
            *)
                dir="$arg"
                ;;
        esac
    done

    local pkgbase="${PKGBASE:-$(pkgbase_of "${dir}")}"
    log_section "$(_tf 'AUR check: $pkgbase')"

    if [[ ! -x "${SCANNER}" ]]; then
        log_warn "$(_t "cachyos-pi-scan is not installed, so nothing was checked. Install it with: sudo pacman -S cachyos-pi-scan")"
        exit 0
    fi

    local status=0 findings
    findings="$("${SCANNER}" "${dir}")" || status=$?
    [[ -n "${findings}" ]] && printf '%s\n' "${findings}" | colorize
    echo
    aur_history "${pkgbase}" | colorize
    echo
    update_diff "${dir}"
    echo
    log_info "$(_t "A reading aid, not a guarantee: read the PKGBUILD before you trust it.")"

    case "${status}" in
        2)
            if ! ask_to_continue "${pkgbase}"; then
                log_warn "$(_tf 'Build of $pkgbase stopped.')"
                exit 1
            fi
            ;;
        3)
            log_warn "$(_t "The PKGBUILD could not be read, so it was not checked.")"
            ;;
    esac
    exit 0
}

main "$@"
