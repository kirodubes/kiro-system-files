#!/bin/bash
set -Euo pipefail
##################################################################################################################
# Author    : Erik Dubois
# Website   : https://kiroproject.be
##################################################################################################################
#
#   DO NOT JUST RUN THIS. EXAMINE AND JUDGE. RUN AT YOUR OWN RISK.
#
#   Purpose:
#   Switches the AUR check (kiro-aur-check) on or off in /etc/paru.conf by managing one
#   "PreBuildCommand = /usr/local/bin/kiro-aur-check" line under [bin], marked with a
#   "# Kiro: AUR check" comment. Without arguments it only adds the line when there is no marker
#   and no PreBuildCommand yet: that is what the pacman hook runs after paru or kiro-system-files
#   is installed or updated, so the check is on by default and a user's own choice is never
#   overwritten. --enable / --disable / --status are for ATT and for people.
#
#   Why: paru reads one config file; /etc/paru.conf belongs to the paru package, so Kiro adds
#   its line in place instead of shipping the file.
#
##################################################################################################################

# shellcheck source=/usr/local/lib/kiro-common.sh
if [[ -f /usr/local/lib/kiro-common.sh ]]; then
    source /usr/local/lib/kiro-common.sh
else
    echo "ERROR: kiro-common.sh not found" >&2
    exit 1
fi

# shellcheck disable=SC2034  # template variable, unused here
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PARU_CONF="${KIRO_PARU_CONF:-/etc/paru.conf}"
MARKER="# Kiro: AUR check — shows risky PKGBUILD lines before paru builds (kiro-aur-check)"
LINE="PreBuildCommand = /usr/local/bin/kiro-aur-check"

has_marker() { grep -q '^# Kiro: AUR check' "${PARU_CONF}"; }
active_line() { grep -E '^[[:space:]]*PreBuildCommand[[:space:]]*=' "${PARU_CONF}" | head -1; }

status() {
    local current
    current="$(active_line || true)"
    if [[ "${current}" == *kiro-aur-check* ]]; then
        echo "on"
    elif [[ -n "${current}" ]]; then
        echo "other"
    else
        echo "off"
    fi
}

add_line() {
    local tmp
    tmp="$(mktemp "${PARU_CONF}.XXXXXX")"
    if grep -qE '^[[:space:]]*\[bin\][[:space:]]*$' "${PARU_CONF}"; then
        awk -v marker="${MARKER}" -v line="${LINE}" '
            { print }
            /^[[:space:]]*\[bin\][[:space:]]*$/ && !done { print marker; print line; done = 1 }
        ' "${PARU_CONF}" > "${tmp}"
    else
        { cat "${PARU_CONF}"; printf '\n[bin]\n%s\n%s\n' "${MARKER}" "${LINE}"; } > "${tmp}"
    fi
    chmod 644 "${tmp}"
    mv "${tmp}" "${PARU_CONF}"
}

enable_check() {
    case "$(status)" in
        on) return 0 ;;
        other)
            log_warn "$(_t "paru.conf already runs another PreBuildCommand; it was left alone.")"
            return 1
            ;;
    esac
    if has_marker && grep -qE '^#[[:space:]]*PreBuildCommand[[:space:]]*=[[:space:]]*/usr/local/bin/kiro-aur-check' "${PARU_CONF}"; then
        sed -i -E 's|^#[[:space:]]*(PreBuildCommand[[:space:]]*=[[:space:]]*/usr/local/bin/kiro-aur-check)|\1|' "${PARU_CONF}"
    else
        add_line
    fi
}

disable_check() {
    [[ "$(status)" == "on" ]] || return 0
    sed -i -E 's|^([[:space:]]*PreBuildCommand[[:space:]]*=[[:space:]]*/usr/local/bin/kiro-aur-check)|#\1|' "${PARU_CONF}"
}

# The hook: add the line once. A marker (even with the line switched off) or someone else's
# PreBuildCommand means a choice was made already.
ensure_default() {
    has_marker && return 0
    [[ -n "$(active_line || true)" ]] && return 0
    add_line
}

main() {
    local action="ensure" arg
    for arg in "$@"; do
        case "$arg" in
            -h|--help)
                show_help "$(basename "$0")" \
                    "Switch the AUR check before paru builds on or off in /etc/paru.conf" \
                    "[--help] [--version] [--enable | --disable | --status]" \
                    "Without an option the check is added once, unless paru.conf already has a choice"
                exit 0
                ;;
            -v|--version)
                show_version "$(basename "$0")"
                exit 0
                ;;
            --enable) action="enable" ;;
            --disable) action="disable" ;;
            --status) action="status" ;;
            *)
                echo "${RED}$(_t "Unknown option:") ${arg}${RESET}" >&2
                exit 1
                ;;
        esac
    done

    if [[ ! -f "${PARU_CONF}" ]]; then
        [[ "${action}" == "status" ]] && echo "no-paru"
        exit 0
    fi
    if [[ "${action}" == "status" ]]; then
        status
        exit 0
    fi
    if [[ $EUID -ne 0 && -z "${KIRO_PARU_CONF:-}" ]]; then
        echo "${RED}$(_t "This script must be run as root.")${RESET}" >&2
        exit 1
    fi

    case "${action}" in
        ensure) ensure_default ;;
        enable) enable_check || exit 1; log_success "$(_t "AUR check switched on for paru.")" ;;
        disable) disable_check; log_success "$(_t "AUR check switched off for paru.")" ;;
    esac
    exit 0
}

main "$@"
